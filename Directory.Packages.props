<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Wolverine -->
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.5.4" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.5.0" />
    <PackageVersion Include="MailKit" Version="4.18.0" />
    <PackageVersion Include="Mjml.Net" Version="4.15.0" />
    <PackageVersion Include="WolverineFx" Version="6.40.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.40.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.40.0" />
    <PackageVersion Include="WolverineFx.Http.Marten" Version="6.40.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.40.0" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.40.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.40.0" />
    <!-- Marten -->
    <PackageVersion Include="Marten" Version="9.39.1" />
    <!-- SmartEnum -->
    <PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0" />
    <PackageVersion Include="Ardalis.SmartEnum.SystemTextJson" Version="8.1.0" />
    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <!-- PDF -->
    <PackageVersion Include="QuestPDF" Version="2026.9.0" />
    <!-- Barcode / QR Code -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- MinIO (Object Storage) -->
    <PackageVersion Include="Minio" Version="7.0.0" />
    <!-- Auth -->
    <PackageVersion Include="Keycloak.AuthServices.Authentication" Version="3.0.0" />
    <PackageVersion Include="Keycloak.AuthServices.Authorization" Version="3.0.0" />
    <PackageVersion Include="Keycloak.AuthServices.Sdk" Version="3.0.0" />
    <PackageVersion Include="Duende.AccessTokenManagement" Version="4.2.0" />
    <!-- Caching -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.5.4" />
    <!-- Kararlı sürümü yok. 13.4+ geliştirici sertifikasıyla HTTPS'e geçer; AppHost bunu
         WithoutHttpsCertificate() ile kapatır (bkz. MESNET.AppHost/Program.cs). -->
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.5.4-preview.1.26464.4" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.4" />
    <PackageVersion Include="Aspire.Npgsql" Version="13.5.4" />
    <!-- Kiracı damgası bütünlük testi (#149) doğrudan SQL ile bakar; Marten'a bağlı değil. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.5.4" />
    <!-- Telemetry (ServiceDefaults) -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Eski AspNetCore.OpenApi transitive olarak Microsoft.OpenApi 2.0.0 çekiyordu; o sürümde NU1903
         (GHSA-v5pm-xwqc-g5wc) yüksek önem açığı var → 2.x'in yamalı en son sürümüne pin.
         3.x'e ÇEKİLMEZ: Microsoft.AspNetCore.OpenApi 10.0.12 [2.12.0, 3.0.0) aralığını ister. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.9" />
    <!-- Seeder -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- Test (API black-box, BDD-style xUnit) — xunit.v3 Microsoft.Testing.Platform ile koşar
         (global.json test.runner); VSTest köprüleri (Test.Sdk, runner.visualstudio) gerekmez. -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
