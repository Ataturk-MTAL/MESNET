<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <!-- ASPIRE010: CLI paketi (AspireUseCliBundle) kapalı. AppHost `dotnet run` ile başlar
         (scripts/run-apphost.sh); Aspire CLI'ın `aspire run`/`publish` özellikleri kullanılmıyor.
         Paketi açmak kullanılmayan bir bağımlılık indirtirdi. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MESNET.Presentation/MESNET.Presentation.csproj" />
    <ProjectReference Include="../MESNET.Seeder/MESNET.Seeder.csproj" />
  </ItemGroup>

</Project>
