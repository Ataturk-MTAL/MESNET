{
  "Parameters": {
    "postgres-password": "<POSTGRES_PASSWORD>",
    "rabbitmq-user": "<RABBITMQ_USER>",
    "rabbitmq-password": "<RABBITMQ_PASSWORD>",
    "keycloak-password": "<KEYCLOAK_ADMIN_PASSWORD>",
    "minio-user": "<MINIO_USER>",
    "minio-password": "<MINIO_PASSWORD>",
    "openobserve-user": "<OPENOBSERVE_ROOT_EMAIL>",
    "openobserve-password": "<OPENOBSERVE_ROOT_PASSWORD>"

    // Uygulama veritabanı rolleri (#316) — İSTEĞE BAĞLI. Yazılmazsa Aspire her açılışta 24
    // karakterlik parola ÜRETİR ve db-init rolleri o parolayla yeniden yazar; iki taraf hep uyumlu
    // kalır. Sabit parola yalnız veritabanına dışarıdan (psql, pgAdmin) bu rollerle bağlanmak
    // istiyorsanız gerekir. `;` içermemeli.
    //   mesnet-owner-password  mesnet_owner: şema sahibi — dev API bununla bağlanır (şemayı kurar)
    //   mesnet-app-password    mesnet_app: yalnız DML, RLS'i atlamaz — üretim/CI API rolü
    //
    // Sabit parola için yorumu kaldırın (önceki satırın sonuna virgül ekleyerek):
    //   "mesnet-owner-password": "<MESNET_DB_OWNER_PASSWORD>",
    //   "mesnet-app-password": "<MESNET_DB_APP_PASSWORD>"
    // Yer tutucuyu olduğu gibi BIRAKMAYIN — Aspire onu gerçek parola sayar ve üretmez.
  }
}
