@startuml ClassDiagram
left to right direction

package "MESNET.Business.Api" {
    class BusinessEndpoints {
        +[WolverineGet] GetBusinessInfo(businessId)
        +[WolverinePost] RegisterBusiness(command)
        +[WolverinePost] SelfRegisterBusiness(command)
        +[WolverinePut] UpdateBusinessInfo(command)
        +[WolverinePost] ApproveBusiness(command)
        +[WolverinePost] RejectBusiness(command)
        +[WolverinePost] DeactivateBusiness(command)
        +[WolverinePost] ActivateBusiness(command)
        +[WolverinePost] CloseBusiness(command)
        +[WolverinePost] UploadDocument(command)
        +[WolverinePost] UpdateCapacity(command)
        +[WolverinePost] RequestTermination(command)
    }
}

package "MESNET.Business.Application" {
    class RegisterBusinessHandler {
        +static BusinessRegistered Handle(RegisterBusiness command, IDocumentSession session)
    }

    class SelfRegisterBusinessHandler {
        +static BusinessApprovalRequested Handle(SelfRegisterBusiness command, IDocumentSession session)
    }

    class ApproveBusinessHandler {
        +static BusinessApproved Handle(ApproveBusiness command, IDocumentSession session)
    }

    class RejectBusinessHandler {
        +static BusinessRejected Handle(RejectBusiness command, IDocumentSession session)
    }

    class UpdateBusinessInfoHandler {
        +static BusinessUpdated Handle(UpdateBusinessInfo command, IDocumentSession session)
    }

    class DeactivateBusinessHandler {
        +static BusinessDeactivated Handle(DeactivateBusiness command, IDocumentSession session)
    }

    class ActivateBusinessHandler {
        +static BusinessRegistered Handle(ActivateBusiness command, IDocumentSession session)
    }

    class CloseBusinessHandler {
        +static BusinessClosed Handle(CloseBusiness command, IDocumentSession session)
    }

    class UploadDocumentHandler {
        +static BusinessDocumentUploaded Handle(UploadDocument command, IDocumentSession session)
    }

    class ApproveDocumentHandler {
        +static BusinessDocumentApproved Handle(ApproveDocument command, IDocumentSession session)
    }

    class UpdateCapacityHandler {
        +static BusinessCapacityChanged Handle(UpdateCapacity command, IDocumentSession session)
    }

    class RequestTerminationHandler {
        +static BusinessTerminationRequested Handle(RequestTermination command, IDocumentSession session)
    }

    note "SelfRegisterBusiness: İşletme kendi kaydını\naçar → ONAY_BEKLIYOR durumunda oluşturulur.\nKurum onaylamadan sisteme üye olamaz.\n\nRegisterBusiness: Kurum kaydeder → direkt AKTİF." as RegNote
    SelfRegisterBusinessHandler .. RegNote
}

package "MESNET.Business.Core" {
    class Business <<AggregateRoot>> {
        +Guid Id
        +string Name
        +string Address
        +string PhoneNumber
        +string Email
        +string Website
        +BusinessStatus Status
        +RegistrationSource Source
        +int PersonnelCount
        +Location Location
        +BusinessCapacity Capacity
        +List<BusinessRepresentative> Representatives
        +List<BusinessDocument> Documents
        +DateTime CreatedAt
        +DateTime? ApprovedAt
        +DateTime? ClosedAt
    }

    class BusinessRepresentative {
        +Guid Id
        +Guid BusinessId
        +string FirstName
        +string LastName
        +string PhoneNumber
        +string Email
        +string KeycloakId
    }

    class BusinessDocument {
        +Guid Id
        +Guid BusinessId
        +DocumentType Type
        +string FileName
        +string FilePath
        +DateTime UploadedAt
        +DateTime? ApprovedAt
        +DateTime? ExpiresAt
        +DocumentStatus Status
    }

    class Location <<Value Object>> {
        +double Latitude
        +double Longitude
    }

    class BusinessCapacity <<Value Object>> {
        +int TotalSlots
        +int OccupiedSlots
        +int AvailableSlots
    }

    enum BusinessStatus <<Enum>> {
        #ONAY_BEKLIYOR
        #AKTIF
        #REDDEDILDI
        #PASIF
        #KAPATILMIS
    }

    enum RegistrationSource <<Enum>> {
        #KURUM_KAYDI
        #ISLETME_KENDI_KAYDI
    }

    enum DocumentType <<Enum>> {
        #USTALIK_BELGESI
        #USTA_OGRETICILIK_BELGESI
    }

    enum DocumentStatus <<Enum>> {
        #YUKLENDI
        #ONAYLANDI
        #REDDEDILDI
        #SURESI_DOLDU
    }
}

package "MESNET.Business.Shared" {
    class BusinessRegistered {
        +Guid BusinessId
        +string Name
        +Location Location
        +RegistrationSource Source
    }

    class BusinessApprovalRequested {
        +Guid BusinessId
        +string Name
        +Guid InstitutionId
    }

    class BusinessApproved {
        +Guid BusinessId
        +string ApprovedBy
        +DateTime ApprovedAt
    }

    class BusinessRejected {
        +Guid BusinessId
        +string RejectedBy
        +string Reason
    }

    class BusinessUpdated {
        +Guid BusinessId
        +string Name
        +Location Location
    }

    class BusinessDeactivated {
        +Guid BusinessId
        +string Reason
        +DateTime DeactivatedAt
    }

    class BusinessClosed {
        +Guid BusinessId
        +string Reason
        +DateTime ClosedAt
    }

    class BusinessDocumentUploaded {
        +Guid BusinessId
        +Guid DocumentId
        +DocumentType Type
        +DateTime UploadedAt
    }

    class BusinessDocumentApproved {
        +Guid BusinessId
        +Guid DocumentId
        +DocumentType Type
        +DateTime ApprovedAt
    }

    class BusinessCapacityChanged {
        +Guid BusinessId
        +int TotalSlots
        +int OccupiedSlots
        +int AvailableSlots
    }

    class BusinessTerminationRequested {
        +Guid BusinessId
        +Guid StudentId
        +string Reason
        +DateTime RequestedAt
    }
}

package "MESNET.Business.Persistence" {
    class BusinessMartenConfig <<IConfigureMarten>> {
        +void Configure(StoreOptions options)
    }

    note "Schema: business\nHybrid Storage:\n- İşletme bilgileri → Document (Marten JSONB)\n- Durum geçişleri → Event Sourcing\n  (geçmiş veriler kaybolmaz)\n\nDurum geçişleri:\nONAY_BEKLIYOR → AKTİF / REDDEDİLDİ\nAKTİF ↔ PASİF\nAKTİF / PASİF → KAPATILMIŞ" as PersistenceNote
    BusinessMartenConfig .. PersistenceNote
}

' Domain Relationships
Business --> BusinessRepresentative : has many
Business --> BusinessDocument : has many
Business --> Location : has one
Business --> BusinessCapacity : has one
Business --> BusinessStatus : enum
Business --> RegistrationSource : enum
BusinessDocument --> DocumentType : enum
BusinessDocument --> DocumentStatus : enum

' API -> Handler
BusinessEndpoints --> RegisterBusinessHandler : Wolverine InvokeAsync
BusinessEndpoints --> SelfRegisterBusinessHandler : Wolverine InvokeAsync
BusinessEndpoints --> ApproveBusinessHandler : Wolverine InvokeAsync
BusinessEndpoints --> RejectBusinessHandler : Wolverine InvokeAsync
BusinessEndpoints --> UpdateBusinessInfoHandler : Wolverine InvokeAsync
BusinessEndpoints --> DeactivateBusinessHandler : Wolverine InvokeAsync
BusinessEndpoints --> CloseBusinessHandler : Wolverine InvokeAsync
BusinessEndpoints --> UploadDocumentHandler : Wolverine InvokeAsync
BusinessEndpoints --> UpdateCapacityHandler : Wolverine InvokeAsync
BusinessEndpoints --> RequestTerminationHandler : Wolverine InvokeAsync

' Handler -> Events (cascading messages)
RegisterBusinessHandler --> BusinessRegistered : returns (cascading)
SelfRegisterBusinessHandler --> BusinessApprovalRequested : returns (cascading)
ApproveBusinessHandler --> BusinessApproved : returns (cascading)
RejectBusinessHandler --> BusinessRejected : returns (cascading)
UpdateBusinessInfoHandler --> BusinessUpdated : returns (cascading)
DeactivateBusinessHandler --> BusinessDeactivated : returns (cascading)
CloseBusinessHandler --> BusinessClosed : returns (cascading)
UploadDocumentHandler --> BusinessDocumentUploaded : returns (cascading)
ApproveDocumentHandler --> BusinessDocumentApproved : returns (cascading)
UpdateCapacityHandler --> BusinessCapacityChanged : returns (cascading)
RequestTerminationHandler --> BusinessTerminationRequested : returns (cascading)

@enduml
