{
  // mesnet_app: yalnız DML, NOSUPERUSER NOBYPASSRLS (#316). Süper kullanıcı row-level security'yi
  // atlar; açılış kontrolü bunu LogCritical ile bildirir. Şemayı göç adımı (migrate) mesnet_owner
  // ile kurar — API bu dosyayla DDL denemez.
  // NOT: ${...} yer tutucularını .NET GENİŞLETMEZ; gerçek değerler ortam değişkeniyle verilir
  // (ConnectionStrings__mesnet). Desteklenen yol: deploy/compose.yml.
  "ConnectionStrings": {
    "mesnet": "Host=postgres;Port=5432;Database=mesnet;Username=mesnet_app;Password=${MESNET_DB_APP_PASSWORD}"
  },
  // Şemayı API KURMAZ (#316) — varsayılan zaten false (Development dışı); açıkça yazıldı.
  "Database": {
    "AutoCreateSchema": false
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}"
  },
  "Keycloak": {
    "realm": "mesnet",
    "auth-server-url": "${KEYCLOAK_URL}/",
    "ssl-required": "external",
    "resource": "mesnet-api",
    "verify-token-audience": true,
    "credentials": {
      "secret": "${KEYCLOAK_CLIENT_SECRET}"
    }
  },
  "MinioStorage": {
    "Endpoint": "rustfs:9000",
    "AccessKey": "${MINIO_ROOT_USER}",
    "SecretKey": "${MINIO_ROOT_PASSWORD}",
    "UseSSL": false,
    "DefaultBucket": "payment-receipts"
  },
  "FrontendUrl": "${FRONTEND_URL}",
  "SmtpSettings": {
    "Host": "${SMTP_HOST}",
    "Port": 587,
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "MESNET Sistemi"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Wolverine": "Warning",
      "Marten": "Warning"
    }
  }
}
