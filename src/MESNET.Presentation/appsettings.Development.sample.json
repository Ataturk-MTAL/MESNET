{
  // Aspire (run-apphost.sh) bu bağlantıyı ortam değişkeniyle EZER: mesnet_owner ve üretilen parola.
  // Dosya yalnız API'yi Aspire'sız çalıştırırken kullanılır. SÜPER KULLANICI YAZMAYIN (#316):
  // açılış kontrolü Development'ta süper kullanıcı/BYPASSRLS bağlantısında açılışı durdurur.
  //   Şemayı API kuracaksa (AutoCreateSchema=true): mesnet_owner
  //   Şema göç adımıyla kurulduysa (AutoCreateSchema=false): mesnet_app
  "ConnectionStrings": {
    "mesnet": "Host=localhost;Port=5432;Database=mesnet;Username=mesnet_owner;Password=<MESNET_DB_OWNER_PASSWORD>"
  },
  // Database:AutoCreateSchema — şemayı API açılışta kurar mı (#316). Varsayılan: yalnız Development'ta
  // true. false ise şema `dotnet MESNET.Presentation.dll resources setup` ile, mesnet_owner rolüyle
  // kurulur (üretim ve CI akışı). Ortam değişkeni: Database__AutoCreateSchema
  "Database": {
    "AutoCreateSchema": true
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "<RABBITMQ_USER>",
    "Password": "<RABBITMQ_PASSWORD>"
  },
  "Keycloak": {
    "realm": "mesnet",
    "auth-server-url": "http://localhost:8080/",
    "ssl-required": "none",
    "resource": "mesnet-api",
    "verify-token-audience": false,
    "credentials": {
      "secret": "<KEYCLOAK_CLIENT_SECRET>"
    }
  },
  "MinioStorage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "<MINIO_ACCESS_KEY>",
    "SecretKey": "<MINIO_SECRET_KEY>",
    "UseSSL": false,
    "DefaultBucket": "payment-receipts"
  },
  "Osrm": {
    "BaseUrl": "http://localhost:5002"
  },
  "FrontendUrl": "http://localhost:5173",
  "SmtpSettings": {
    "Host": "localhost",
    "Port": 1025,
    "FromEmail": "noreply@mesnet.local",
    "FromName": "MESNET Sistemi"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Wolverine": "Debug",
      "Marten": "Debug"
    }
  }
}
