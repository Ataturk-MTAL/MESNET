{
  "ConnectionStrings": {
    "mesnet": "Host=postgres;Port=5432;Database=mesnet;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}"
  },
  "Keycloak": {
    "realm": "mesnet",
    "auth-server-url": "${KEYCLOAK_URL}/",
    "ssl-required": "external",
    "resource": "mesnet-api",
    "verify-token-audience": true,
    "credentials": {
      "secret": "${KEYCLOAK_CLIENT_SECRET}"
    }
  },
  "MinioStorage": {
    "Endpoint": "minio:9000",
    "AccessKey": "${MINIO_ROOT_USER}",
    "SecretKey": "${MINIO_ROOT_PASSWORD}",
    "UseSSL": false,
    "DefaultBucket": "payment-receipts"
  },
  "FrontendUrl": "${FRONTEND_URL}",
  "SmtpSettings": {
    "Host": "${SMTP_HOST}",
    "Port": 587,
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "MESNET Sistemi"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Wolverine": "Warning",
      "Marten": "Warning"
    }
  }
}
