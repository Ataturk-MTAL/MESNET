<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Keycloak.AuthServices.Authorization" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Minio" />
    <PackageReference Include="Mjml.Net" />
    <!-- TenantEnricher — her log kaydına kiracı (kurum) kimliği ekler. Serilog.AspNetCore
         ILogEventEnricher'ı da getirir; ayrı bir Serilog paketi gerekmez. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- TenantResolutionMiddleware — IMessageBus.TenantId'yi istek başına ayarlar (#149).
         Wolverine düz Minimal API'de kiracıyı otomatik tespit etmez. -->
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MESNET.Common.Shared/MESNET.Common.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Email/Templates/**/*.mjml" />
    <EmbeddedResource Include="Email/Assets/**/*" />
  </ItemGroup>

</Project>
