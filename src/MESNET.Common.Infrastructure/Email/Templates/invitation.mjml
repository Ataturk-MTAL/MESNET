<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Segoe UI', Tahoma, Geneva, Verdana, sans-serif" />
      <mj-text font-size="15px" color="#374151" line-height="1.6" />
      <mj-button font-size="16px" font-weight="600" />
    </mj-attributes>
    <mj-style>
      .footer-text { font-size: 12px !important; color: #9ca3af !important; }
      .role-badge { background-color: #eff6ff; color: #1d4ed8; padding: 4px 12px; border-radius: 4px; font-weight: 600; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <!-- Spacer -->
    <mj-section padding="20px 0 0 0"></mj-section>

    <!-- Header with Logo -->
    <mj-section background-color="#1e40af" padding="24px 40px" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-image src="cid:mesnet-logo" alt="MESNET" width="160px" align="left" />
      </mj-column>
    </mj-section>

    <!-- Blue accent bar -->
    <mj-section background-color="#2563eb" padding="4px 0"></mj-section>

    <!-- Main Content -->
    <mj-section background-color="#ffffff" padding="32px 40px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#111827" padding-bottom="8px">
          Merhaba {{FullName}},
        </mj-text>
        <mj-text>
          MESNET sistemine <span class="role-badge">{{TargetRole}}</span> olarak davet edildiniz.
        </mj-text>
        <mj-text>
          Kaydınızı tamamlamak ve sisteme erişim sağlamak için aşağıdaki butona tıklayın.
        </mj-text>
        <mj-button background-color="#2563eb" color="#ffffff" border-radius="8px" padding="24px 0" inner-padding="14px 32px" href="{{RegistrationLink}}">
          Kayıt Ol
        </mj-button>
        <mj-text padding-top="4px" font-size="13px" color="#6b7280">
          Buton çalışmıyorsa aşağıdaki bağlantıyı tarayıcınıza yapıştırın:
        </mj-text>
        <mj-text font-size="13px" color="#2563eb" word-break="break-all">
          <a href="{{RegistrationLink}}" style="color:#2563eb;">{{RegistrationLink}}</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Warning -->
    <mj-section background-color="#fefce8" padding="16px 40px" border-top="1px solid #fde68a">
      <mj-column>
        <mj-text font-size="13px" color="#92400e">
          Bu bağlantı <strong>7 gün</strong> geçerlidir. Süre dolduktan sonra yeniden davet gönderilmesi gerekecektir.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" padding="20px 40px" border-radius="0 0 12px 12px" border-top="1px solid #e5e7eb">
      <mj-column>
        <mj-text css-class="footer-text" align="center">
          Bu e-posta MESNET sistemi tarafından otomatik olarak gönderilmiştir.<br />
          Eğer bu daveti siz talep etmediyseniz, bu mesajı görmezden gelebilirsiniz.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bottom spacer -->
    <mj-section padding="0 0 20px 0"></mj-section>
  </mj-body>
</mjml>
