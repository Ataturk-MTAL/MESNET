left to right direction

package "MESNET.Reporting.Api" {
    class ReportingEndpoints {
        +[WolverineGet] GetAttendanceReport(query)
        +[WolverineGet] GetPaymentReport(query)
        +[WolverineGet] GetInternshipStatusReport(query)
        +[WolverineGet] GetInstitutionStatistics(query)
        +[WolverinePost] GeneratePdfReport(command)
        +[WolverinePost] GenerateTerminationReport(command)
        +[WolverinePost] GenerateBulkExport(command)
        +[WolverinePost] GenerateCoordinatorDailyForm(command)
        +[WolverinePost] GenerateCoordinatorMonthlyForm(command)
        +[WolverinePost] GenerateAttendanceSheet(command)
    }
}

package "MESNET.Reporting.Application" {
    class GeneratePdfReportHandler {
        +static ReportGenerated Handle(GeneratePdfReport command, IDocumentSession session)
    }

    class GenerateBulkExportHandler {
        +static BulkExportGenerated Handle(GenerateBulkExport command, IDocumentSession session)
    }

    class GenerateTerminationReportHandler {
        +static TerminationReportGenerated Handle(GenerateTerminationReport command, IDocumentSession session)
    }

    class GenerateCoordinatorDailyFormHandler {
        +static ReportGenerated Handle(GenerateCoordinatorDailyForm command, IDocumentSession session)
    }

    class GenerateCoordinatorMonthlyFormHandler {
        +static ReportGenerated Handle(GenerateCoordinatorMonthlyForm command, IDocumentSession session)
    }

    class GenerateAttendanceSheetHandler {
        +static ReportGenerated Handle(GenerateAttendanceSheet command, IDocumentSession session)
    }

    note "Query handler'lar Marten\nIQuerySession ile doğrudan\ndenormalize document okur.\n\nGenerateTerminationReportHandler:\nQuestPDF ile fesih formu PDF üretir.\n\nGünlük Form: Ziyaret yoklaması,\nöğrenci bazlı devam/gözlem.\nAylık Form: Devam özeti, maaş,\nsözleşme durumu.\nDevamsızlık Çizelgesi: Gün bazlı\ndurum matrisi (V/Y/M/S/T)." as QueryNote
}

