package "MESNET.Reporting.Core\n«Denormalized Read Models»" {
    class StudentReportView <<Document>> {
        +Guid Id
        +Guid StudentId
        +string FullName
        +Guid InstitutionId
        +string InstitutionName
        +Guid? BusinessId
        +string? BusinessName
        +string ContractStatus
        +int TotalAbsenceDays
        +int ApprovedPaymentCount
        +DateTime LastUpdated
    }

    class BusinessReportView <<Document>> {
        +Guid Id
        +Guid BusinessId
        +string BusinessName
        +int ActiveInternCount
        +int TotalCapacity
        +int CompletedInternCount
        +DateTime LastUpdated
    }

    class AttendanceReportView <<Document>> {
        +Guid Id
        +Guid StudentId
        +string StudentName
        +Guid InstitutionId
        +List<AbsenceRecord> Absences
        +int TotalAbsenceDays
        +bool LimitExceeded
        +DateTime LastUpdated
    }

    class PaymentReportView <<Document>> {
        +Guid Id
        +Guid StudentId
        +string StudentName
        +Guid InstitutionId
        +List<PaymentRecord> Payments
        +decimal TotalPaid
        +int PendingCount
        +DateTime LastUpdated
    }

    class InstitutionReportView <<Document>> {
        +Guid Id
        +Guid InstitutionId
        +string InstitutionName
        +int ActiveStudentCount
        +int ActiveBusinessCount
        +int TotalInternships
        +decimal AverageAbsenceRate
        +DateTime LastUpdated
    }

    class AbsenceRecord <<Value Object>> {
        +DateTime Date
        +string Reason
        +bool IsVerified
    }

    class PaymentRecord <<Value Object>> {
        +string Month
        +decimal Amount
        +string Status
        +DateTime? ApprovedAt
    }

    class TerminationReportView <<Document>> {
        +Guid Id
        +Guid InternshipId
        +Guid StudentId
        +string StudentName
        +string StudentClass
        +Guid BusinessId
        +string BusinessName
        +Guid InstitutionId
        +string InstitutionName
        +string TerminationReason
        +string TerminationReasonDetail
        +bool ParentApproved
        +bool TeacherApproved
        +bool DeputyApproved
        +bool DirectorApproved
        +bool BusinessRepApproved
        +bool IsOverridden
        +string? OverriddenBy
        +DateTime? FormGeneratedAt
        +string? SignedFormUrl
        +DateTime LastUpdated
    }

    class CoordinatorDailyFormView <<Document>> {
        +Guid Id
        +Guid TeacherId
        +string TeacherName
        +Guid BusinessId
        +string BusinessName
        +DateTime Date
        +int StudentCount
        +List<StudentDailyRecord> Students
        +string? Notes
        +DateTime LastUpdated
    }

    class StudentDailyRecord <<Value Object>> {
        +Guid StudentId
        +string StudentName
        +bool IsPresent
        +string? AbsenceType
        +string? Notes
    }

    class CoordinatorMonthlyFormView <<Document>> {
        +Guid Id
        +Guid TeacherId
        +string TeacherName
        +Guid BusinessId
        +string BusinessName
        +string Month
        +int TotalVisitDays
        +int TotalStudents
        +List<StudentMonthlyRecord> Students
        +decimal TotalSalaryPaid
        +DateTime LastUpdated
    }

    class StudentMonthlyRecord <<Value Object>> {
        +Guid StudentId
        +string StudentName
        +int PresentDays
        +int AbsentDays
        +decimal SalaryAmount
        +string ContractStatus
    }

    class AttendanceSheetView <<Document>> {
        +Guid Id
        +Guid InstitutionId
        +Guid BusinessId
        +string BusinessName
        +string Month
        +List<AttendanceSheetRow> Rows
        +DateTime LastUpdated
    }

    class AttendanceSheetRow <<Value Object>> {
        +Guid StudentId
        +string StudentName
        +List<DayStatus> Days
    }

    class DayStatus <<Value Object>> {
        +int DayNumber
        +string Status
    }

    note "DayStatus.Status kodları:\nV=var, Y=yok, M=mazeretli,\nS=sağlık raporu, T=tatil" as DayStatusNote
    DayStatus .. DayStatusNote
}

package "MESNET.Reporting.Shared" {
    class ReportGenerated {
        +Guid ReportId
        +ReportType Type
        +string FileName
    }

    class BulkExportGenerated {
        +Guid ExportId
        +ExportFormat Format
        +string FileName
    }

    class TerminationReportGenerated {
        +Guid ReportId
        +Guid InternshipId
        +Guid StudentId
        +string FileName
    }

    enum ReportType <<Enum>> {
        #DEVAMSIZLIK
        #MAAS
        #STAJ_DURUMU
        #KURUM_ISTATISTIK
        'CAPRAZ_KURUM → Phase 2 (Tenant modülü ile)
        #FESIH_FORMU
        #GUNLUK_FORM
        #AYLIK_FORM
        #DEVAMSIZLIK_CIZELGESI
    }

    enum ExportFormat <<Enum>> {
        #PDF
        #EXCEL
    }
}

