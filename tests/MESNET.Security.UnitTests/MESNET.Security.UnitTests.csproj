<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test projesinde uyarılar build'i kırmasın -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Modules/Security/MESNET.Security.Application/MESNET.Security.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Keycloak realm tanımı, MesnetRoles ile birebir aynı olmalıdır (#129). Drift testinin
      dosyayı okuyabilmesi için çıktı klasörüne kopyalanır — göreli yol arayışı yerine.
    -->
    <Content Include="../../src/MESNET.AppHost/keycloak/mesnet-realm.json"
             Link="mesnet-realm.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
