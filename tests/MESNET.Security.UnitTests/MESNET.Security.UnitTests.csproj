<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3: test projesi çalıştırılabilir olmak zorunda -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test projesinde uyarılar build'i kırmasın -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Modules/Security/MESNET.Security.Application/MESNET.Security.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Keycloak realm tanımı, MesnetRoles ile birebir aynı olmalıdır (#129). Drift testinin
      dosyayı okuyabilmesi için çıktı klasörüne kopyalanır — göreli yol arayışı yerine.
    -->
    <Content Include="../../src/MESNET.AppHost/keycloak/mesnet-realm.json"
             Link="mesnet-realm.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!--
      Üretim realm şablonu da aynı değişmezlere bağlıdır. İki dosya ayrı yaşadığı için
      kilitlenmezse sapma KESİNDİR: yeni bir rol dev realm'ine eklenir, üretim şablonunda
      unutulur ve yalnız gerçek kurulumda ortaya çıkar.
    -->
    <Content Include="../../deploy/keycloak/mesnet-realm.production.json"
             Link="mesnet-realm.production.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
