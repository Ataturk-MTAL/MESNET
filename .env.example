# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env GIT'E EKLENMEMELİDİR — .gitignore'a ekle.

# Domain & TLS (Caddy)
# APP_DOMAIN ana alan adı; docs.<APP_DOMAIN> (dokümantasyon) ve
# auth.<APP_DOMAIN> (Keycloak) alt alanları buna göre sunulur.
# ACME_EMAIL Let's Encrypt sertifika bildirimleri için kullanılır.
APP_DOMAIN=mesnet.example.com
ACME_EMAIL=admin@mesnet.example.com

# ACME sağlayıcısı — BOŞ BIRAKILIRSA üretim Let's Encrypt kullanılır.
# TEST/STAGING dağıtımında staging uç noktasına çevirin; üretim LE'nin haftalık sertifika
# limiti vardır ve sık yeniden kurulan bir test ortamı onu yakar:
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

# PostgreSQL
POSTGRES_USER=mesnet
POSTGRES_PASSWORD=GUCLU_SIFRE_BURAYA

# RabbitMQ
RABBITMQ_USER=mesnet
RABBITMQ_PASSWORD=GUCLU_SIFRE_BURAYA

# Keycloak
KEYCLOAK_URL=https://auth.mesnet.example.com
KEYCLOAK_HOSTNAME=auth.mesnet.example.com
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=GUCLU_SIFRE_BURAYA
KEYCLOAK_CLIENT_SECRET=KEYCLOAK_CLIENT_SECRET_BURAYA

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=GUCLU_SIFRE_BURAYA

# Uygulama
FRONTEND_URL=https://mesnet.example.com

# Frontend build (Vite — public değerler, SPA bundle'ına GÖMÜLÜR; gizli değil)
# VITE_KEYCLOAK_URL otomatik türetilir: https://auth.${APP_DOMAIN}
VITE_KEYCLOAK_REALM=mesnet
VITE_KEYCLOAK_CLIENT_ID=mesnet-web
# VITE_OSRM_URL=https://osrm.mesnet.example.com   # opsiyonel rota servisi (harita)

# SMTP
SMTP_HOST=smtp.example.com
SMTP_FROM_EMAIL=noreply@mesnet.example.com
