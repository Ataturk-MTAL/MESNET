# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env GIT'E EKLENMEMELİDİR — .gitignore'a ekle.

# Domain & TLS (Caddy)
# APP_DOMAIN ana alan adı; docs.<APP_DOMAIN> (dokümantasyon) ve
# auth.<APP_DOMAIN> (Keycloak) alt alanları buna göre sunulur.
# ACME_EMAIL Let's Encrypt sertifika bildirimleri için kullanılır.
APP_DOMAIN=mesnet.example.com
ACME_EMAIL=admin@mesnet.example.com

# ACME sağlayıcısı — BOŞ BIRAKILIRSA üretim Let's Encrypt kullanılır.
# TEST/STAGING dağıtımında staging uç noktasına çevirin; üretim LE'nin haftalık sertifika
# limiti vardır ve sık yeniden kurulan bir test ortamı onu yakar:
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

# PostgreSQL
# POSTGRES_USER / POSTGRES_PASSWORD  Veritabanı SÜPER KULLANICISI — API bununla BAĞLANMAMALI (#316).
POSTGRES_USER=mesnet
POSTGRES_PASSWORD=GUCLU_SIFRE_BURAYA

# Uygulama rolleri (#316) — süper kullanıcı row-level security'yi (#317) atlar.
# MESNET_DB_OWNER_PASSWORD  mesnet_owner: şema sahibi, yalnız göç adımı (resources setup) kullanır
# MESNET_DB_APP_PASSWORD    mesnet_app: API çalışma zamanı, yalnız DML, RLS'i atlamaz.
#                           appsettings.Production.json'daki bağlantı bu rolü kullanır.
# `;` içermemeli (bağlantı dizesini böler). Üretmek için: openssl rand -hex 24
# NOT: bu dosyanın compose'u (kök docker-compose.yml) rol betiğini ve göç adımını KURMAZ;
#      desteklenen yol deploy/compose.yml'dir (deploy/.env.example).
MESNET_DB_OWNER_PASSWORD=GUCLU_SIFRE_BURAYA
MESNET_DB_APP_PASSWORD=GUCLU_SIFRE_BURAYA

# RabbitMQ
RABBITMQ_USER=mesnet
RABBITMQ_PASSWORD=GUCLU_SIFRE_BURAYA

# Keycloak
KEYCLOAK_URL=https://auth.mesnet.example.com
KEYCLOAK_HOSTNAME=auth.mesnet.example.com
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=GUCLU_SIFRE_BURAYA
KEYCLOAK_CLIENT_SECRET=KEYCLOAK_CLIENT_SECRET_BURAYA

# Nesne deposu — RustFS (adlar MINIO_* olarak kaldı, RustFS kök kimliğine eşlenir)
# MINIO_ROOT_USER      RustFS erişim anahtarı (RUSTFS_ACCESS_KEY)
# MINIO_ROOT_PASSWORD  RustFS gizli anahtarı (RUSTFS_SECRET_KEY) — en az 8 karakter
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=GUCLU_SIFRE_BURAYA

# Uygulama
FRONTEND_URL=https://mesnet.example.com

# Frontend build (Vite — public değerler, SPA bundle'ına GÖMÜLÜR; gizli değil)
# VITE_KEYCLOAK_URL otomatik türetilir: https://auth.${APP_DOMAIN}
VITE_KEYCLOAK_REALM=mesnet
VITE_KEYCLOAK_CLIENT_ID=mesnet-web
# VITE_OSRM_URL=https://osrm.mesnet.example.com   # opsiyonel rota servisi (harita)

# SMTP
SMTP_HOST=smtp.example.com
SMTP_FROM_EMAIL=noreply@mesnet.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Yerel test / CI değişkenleri — docker-compose OKUMAZ; kabuğa export edilir.
# Tanımlanmazsa CI'daki (.github/compose.ci.yml) değerler kullanılır.
# ─────────────────────────────────────────────────────────────────────────────
# ConnectionStrings__mesnet  Veritabanına doğrudan bakan API testlerinin SÜPER KULLANICI
#                            bağlantısı (katalog/damga testleri). Varsayılan: localhost:5432 mesnet
# MESNET_APP_CONNECTION      RLS davranış testlerinin mesnet_app bağlantısı (#317).
#                            Varsayılan: localhost:5432 mesnet_app / mesnet_app_dev
#   Yığın başka portta açıksa İKİSİ DE verilmeli — verilmezse bu testler 5432'ye bağlanıp düşer.
# API_BASE_URL               Kara-kutu testlerin API adresi (ör. http://127.0.0.1:5270)
# KEYCLOAK_TOKEN_URL         Testlerin token uç noktası (…/realms/mesnet/protocol/openid-connect/token)
#
# scripts/ci-local.sh port kaydırmaları (dev yığınıyla çakışmasın diye):
# CI_PG_PORT (5433)  CI_KEYCLOAK_PORT (8081)  CI_S3_PORT (9010, RustFS)  CI_RABBIT_PORT (5673)
# CI_API_PORT (5271) — testlerin konuştuğu API
#
# ConnectionStrings__mesnet=Host=localhost;Port=5433;Database=mesnet;Username=mesnet;Password=mesnet_dev
# MESNET_APP_CONNECTION=Host=localhost;Port=5433;Database=mesnet;Username=mesnet_app;Password=mesnet_app_dev
