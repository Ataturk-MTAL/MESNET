{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MESNET Aspire AppHost",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-apphost",
      "program": "${workspaceFolder}/src/MESNET.AppHost/bin/Debug/net10.0/MESNET.AppHost.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MESNET.AppHost",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPIRE_CONTAINER_RUNTIME": "podman"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "MESNET API (standalone)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/MESNET.Presentation/bin/Debug/net10.0/MESNET.Presentation.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MESNET.Presentation",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
