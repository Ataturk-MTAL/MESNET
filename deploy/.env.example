# MESNET — ÜRETİM ORTAM DEĞİŞKENLERİ
#
# Kopyalayın, doldurun, İZİNLERİNİ KISIN:
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# .env GIT'E EKLENMEZ (depo kökünde .gitignore satırı vardır). Depo PUBLIC'tir; buraya yazılan
# bir parola geri alınamaz.
#
# Zorunlu ama boş bırakılan her değişkende compose AÇILMADAN durur (`${VAR:?}`). Bu bilinçlidir:
# yarı yapılandırılmış bir kurulum, hiç açılmayandan kötüdür.

# ── Sürüm ────────────────────────────────────────────────────────────────────
# Çekilecek GHCR imaj etiketi. `latest` YAZMAYIN — kararlı kurulum sabit etiket ister.
# Yayınlanan sürümler: https://github.com/Ataturk-MTAL/MESNET/releases
MESNET_VERSION=v0.2.2

# ── Alan adı ve TLS ──────────────────────────────────────────────────────────
# APP_DOMAIN ana alan adıdır. İki alt alan adı OTOMATİK sunulur ve ikisinin de DNS'te bu
# sunucuya işaret etmesi ZORUNLUDUR:
#     <APP_DOMAIN>          → uygulama (SPA + /api)
#     auth.<APP_DOMAIN>     → Keycloak
#     docs.<APP_DOMAIN>     → dokümantasyon
# auth kaydı eksikse giriş akışı hiç tamamlanmaz ve API her isteğe 401 döner.
APP_DOMAIN=mesnet.example.gov.tr
ACME_EMAIL=bilgi-islem@example.gov.tr

# Sertifika sağlayıcısı. ÜRETİMDE BOŞ BIRAKIN (compose Let's Encrypt üretimini verir).
# TEST/STAGING kurulumunda staging uç noktasına çevirin: üretim LE'nin haftalık sertifika
# limiti vardır ve sık yeniden kurulan bir test ortamı onu yakar.
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=mesnet
POSTGRES_PASSWORD=

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=mesnet
RABBITMQ_PASSWORD=

# ── MinIO (nesne deposu — dekont, belge, form) ───────────────────────────────
MINIO_ROOT_USER=mesnet
MINIO_ROOT_PASSWORD=

# ── Keycloak ─────────────────────────────────────────────────────────────────
# Bootstrap yöneticisi: YALNIZ Keycloak'ın kendi yönetim konsolu içindir. MESNET'in
# uygulama yöneticisi DEĞİLDİR — o hesap kurulum sırasında ayrıca açılır.
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=

KEYCLOAK_REALM=mesnet
KEYCLOAK_CLIENT_ID=mesnet-api

# BOŞ BIRAKIN. install.sh realm'i kurarken Keycloak'ın ÜRETTİĞİ secret'ı okuyup buraya yazar.
# Elle bir değer yazarsanız API ile Keycloak'ın secret'ı ayrışır ve Admin API çağrıları
# 401 döner — belirtisi "kullanıcı listesi boş" olur, hata değil.
KEYCLOAK_CLIENT_SECRET=

# ── SMTP (devamsızlık tebligatı — hukuki "yazılı bildirim" bu kanaldan sayılır) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@example.gov.tr
# Boşluk içeren değerler TIRNAKLANIR: install.sh .env'i shell ile okur ve tırnaksız
# boşluk "command not found" ile kurulumu durdurur (compose bunu yutar, shell yutmaz).
SMTP_FROM_NAME="MESNET Sistemi"

# DİKKAT: SMTP_USERNAME BOŞSA hem TLS hem kimlik doğrulama KAPANIR ve posta düz metin,
# kimliksiz gider (kod: useSsl = !IsNullOrEmpty(smtpUser)). Kimlik doğrulaması istemeyen bir
# iç röle kullanıyorsanız boş bırakmak bilinçli bir tercihtir; aksi hâlde ikisini de doldurun.
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Denetim izi ──────────────────────────────────────────────────────────────
# Denetim kayıtlarının saklanma süresi (ay). 0 veya negatif verilirse temizlik hiç koşmaz.
AUDIT_RETENTION_MONTHS=24
